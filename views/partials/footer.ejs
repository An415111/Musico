<footer>
  <p>© 2026 Musico 🎵</p>
</footer>

<!-- MINI PLAYER -->
<div id="miniPlayer" class="mini-player" style="display:none;">
  <img id="miniImg" src="" alt="song" class="mini-img"/>
  <div class="mini-info">
    <span id="miniTitle">No song playing</span>
    <input type="range" id="miniProgress" value="0" class="mini-progress">
    <div class="mini-time">
      <span id="miniCurrent">0:00</span> / <span id="miniDuration">0:00</span>
    </div>
  </div>
  <div class="mini-controls">
    <button id="miniPrev" title="Previous">
      <i class="fas fa-step-backward"></i>
    </button>
    <button id="miniPlayPause" title="Play/Pause">
      <i class="fas fa-play"></i>
    </button>
    <button id="miniNext" title="Next">
      <i class="fas fa-step-forward"></i>
    </button>
    <button id="miniQueue" title="Show Queue">
      <i class="fas fa-list"></i>
    </button>
    <button id="miniClose" title="Close">
      <i class="fas fa-times"></i>
    </button>
  </div>
</div>

<!-- QUEUE PANEL -->
<div id="queuePanel" class="queue-panel" style="display:none;">
  <div class="queue-header">
    <h3>🎵 Song Queue</h3>
    <button id="closeQueue"><i class="fas fa-times"></i></button>
  </div>
  <div id="queueList" class="queue-list"></div>
  <button id="clearQueue" class="clear-queue-btn">Clear Queue</button>
</div>



<script src="/js/music.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/miniPlayer.js"></script>
<script src="/js/queue.js"></script>

<!-- ✅ MUSICO AI CHAT — Gemma 4 Powered -->
<!-- Floating Action Button -->
<button id="ai-chat-fab" title="Ask Musico AI" aria-label="Open AI Chat">
  <i class="fas fa-robot" style="font-size:22px;color:white;"></i>
  <span class="ai-badge">1</span>
</button>

<!-- Chat Window -->
<div id="ai-chat-window" role="dialog" aria-label="Musico AI Assistant">

  <!-- Header -->
  <div class="ai-chat-header">
    <div class="ai-avatar">🎵</div>
    <div class="ai-info">
      <div class="ai-name">Musico AI</div>
      <div class="ai-subtitle">
        <span class="ai-online-dot"></span>
        Powered by Gemma 4
      </div>
    </div>
    <button id="ai-chat-close" aria-label="Close chat">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <!-- Quick Chips -->
  <div class="ai-quick-chips"></div>

  <!-- Messages -->
  <div id="ai-messages" role="log" aria-live="polite"></div>

  <!-- Input -->
  <div class="ai-chat-input-area">
    <textarea
      id="ai-chat-input"
      placeholder="Ask about songs, mood, artists…"
      rows="1"
      aria-label="Chat message input"
    ></textarea>
    <button id="ai-chat-send" aria-label="Send message">
      <i class="fas fa-paper-plane"></i>
    </button>
  </div>

  <!-- Powered by -->
  <div class="ai-powered-by">Powered by <span>Gemma 4</span> · Google AI</div>

</div>

<script src="/js/ai-chat.js"></script>

</body>
</html>